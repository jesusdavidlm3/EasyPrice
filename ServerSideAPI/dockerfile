FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["ServerSideAPI/ServerSideAPI.csproj", "ServerSideAPI/"]
COPY ["Libs/Libs.csproj", "Libs/"]
COPY ["Models/Models.csproj", "Models/"]
RUN dotnet restore "ServerSideAPI/ServerSideAPI.csproj"
COPY . .
WORKDIR "/src/ServerSideAPI"
RUN dotnet build "./ServerSideAPI.csproj" -o /app/build

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./ServerSideAPI.csproj" -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
VOLUME /home/jesus/test:/app/EasyPrice
ENTRYPOINT ["dotnet", "ServerSideAPI.dll"]

