<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasyPrice.ViewModels.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:EasyPrice.Converters"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720" MinWidth="800" MinHeight="700"
        WindowState="Maximized"
        x:Class="EasyPrice.Views.Desktop.Administration"
        x:DataType="vm:AdministrationViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Administracion"
        ShowInTaskbar="False">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:AdministrationViewModel/>
    </Design.DataContext>
    
    <Window.Resources>
        <converters:DolarToBs x:Key="DolarToBs"/>
    </Window.Resources>

    <DockPanel>
        <StackPanel 
            DockPanel.Dock="Top" 
            HorizontalAlignment="Left" 
            Spacing="15" Margin="10"
            Orientation="Horizontal">
            <Button
                Content="Agregar productos"
                Command="{Binding ShowAddProductWindowCommand}"/>
            <Button
                Content="Cambiar precio del dolar"
                Command="{Binding ShowSettingsWindowCommand}"/>
            <Button
                Content="Cambiar contraseña"
                Command="{Binding ShowChangePasswordCommand}"/>
            <Button
                Content="Ajustes de servidor"
                Command="{Binding ShowServerSettingsCommand}"/>
        </StackPanel>
        <Grid ColumnDefinitions="1* 15* 1*" RowDefinitions=".25* .5* 4*">
            <TextBlock Grid.Column="1" Grid.Row="0"
                TextAlignment="Center"
                Text="Administracion"
                Margin="1"
                FontSize="30"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                PlaceholderText="Que producto buscas?"
                Text="{Binding SearchText}"
                Height="10"
                Margin="10 0"/>
            <TableView Grid.Row="2" Grid.Column="1"
                Margin="10 0 10 20"
                ItemsSource="{Binding ShownList, Mode=TwoWay}">
                <TableView.Columns>
                    <TableViewColumn
                        Header="Producto"
                        Width="2.3*"
                        Binding="{Binding Name}"/>
                    <TableViewColumn
                        Width="1*"
                        Header="Precio en Bs."
                        Binding="{Binding GetValueDolar, StringFormat=Bs. {0:f2}, Converter={StaticResource DolarToBs}}"/>
                    <TableViewColumn
                        Width="1*"
                        Header="Precio en $"
                        Binding="{Binding GetValueDolar, StringFormat=${0:f2}}"/>
                    <TableViewColumn Width="2*">
                        <TableViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <Button
                                        Content="Cambiar precio"
                                        Classes="Primary"
                                        Command="{Binding DataContext.ShowEditProductWindowCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                    <Button
                                        Content="Eliminar"
                                        Classes="Red"
                                        Command="{Binding DataContext.ShowDeleteProductWindowCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TableViewColumn.CellTemplate>
                    </TableViewColumn>
                </TableView.Columns>
            </TableView>
        </Grid>
    </DockPanel>
</Window>
