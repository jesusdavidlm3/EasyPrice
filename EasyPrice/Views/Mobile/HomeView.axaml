<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="600"
    x:Class="EasyPrice.Views.Mobile.HomeView"
    xmlns:vm="clr-namespace:EasyPrice.ViewModels.Mobile"
    x:DataType="vm:HomeViewModel"
    xmlns:converters="clr-namespace:EasyPrice.Converters">
    
    <UserControl.Resources>
        <converters:DolarToBs x:Key="DolarToBs"/>
    </UserControl.Resources>
    
    <Grid Classes="PrincipalBackground" RowDefinitions="1* 9*">
        <TextBox Grid.Row="0"
            Text="{Binding SearchText}"
            PlaceholderText="Que producto buscas?"
            Height="25"
            Margin="10 0"/>
        <TableView Grid.Row="1" Margin="10 0 10 20"
            ItemsSource="{Binding ShownList, Mode=TwoWay}"
            CanUserResizeColumns="False">
            <TableView.Columns>
                <TableViewColumn
                    Binding="{Binding Name}"
                    Header="Producto"
                    Width="2*"/>
                <TableViewColumn
                    Binding="{Binding GetValueDolar, StringFormat=Bs. {0:f2}, Converter={StaticResource DolarToBs}}"
                    Header="Bs."
                    Width="1*"/>
                <TableViewColumn
                    Header="$"
                    Width="1*"
                    Binding="{Binding GetValueDolar, StringFormat=${0:f2}}"/>
            </TableView.Columns>
        </TableView>
    </Grid>
</UserControl>
