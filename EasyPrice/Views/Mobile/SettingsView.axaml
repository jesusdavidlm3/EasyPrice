<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EasyPrice.ViewModels.Mobile"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="600"
             x:Class="EasyPrice.Views.Mobile.SettingsView"
             x:DataType="vm:SettingsViewModel">
        <StackPanel Classes="PrincipalBackground" Margin="0 20 0 0">
            <Label 
                Content="Direccion de servidor:"
                Margin="20 0"/>
            <TextBox
                Margin="20 0 20 20"/>
            
            <Label
                Content="Contraseña:"
                Margin="20 0"/>
            <TextBox
                PasswordChar="*"
                Margin="20 0 20 20"/>
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="20">
                <Button
                    Classes="Red"
                    Content="Desvincular"
                    Command="{Binding HandleLogoutCommand}"/>
                <Button
                    Content="Vincular"
                    Command="{Binding HandleLoginCommand}"/>
            </StackPanel>
        </StackPanel>
</UserControl>
