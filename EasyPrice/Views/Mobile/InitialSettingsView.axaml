<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="450"
             x:Class="EasyPrice.Views.Mobile.InitialSettingsView">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock
            Text="Bienvenido"
            FontSize="30"
            TextAlignment="Center"/>
        <TextBlock
            Text="a EasyPrice"
            Margin="0 0 0 30"
            TextAlignment="Center"
            />
        <Border 
            CornerRadius="12"
            Background="Gray">
            <StackPanel
                Width="200"
                HorizontalAlignment="Center">
                <TextBlock
                    FontSize="20"
                    Text="Vinculacion"
                    TextAlignment="Center"
                    Margin="0 10 0 0"/>
                <Label
                    Content="Direccion de servidor:"
                    Margin="15 0"/>
                <TextBox
                    Margin=" 15 0"/>
                <Label
                    Content="Contraseña:"
                    Margin=" 15 0"/>
                <TextBox
                    Margin="15 0"/>
                <Button
                    HorizontalAlignment="Center"
                    Content="Vincular"
                    Margin=" 0 15"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
