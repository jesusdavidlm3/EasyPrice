<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" Width="800" Height="450" CanResize="False" WindowStartupLocation="CenterOwner"
        x:Class="EasyPrice.NET.Views.SettingsWindow"
        xmlns:vm="clr-namespace:EasyPrice.NET.ViewModels"
        x:DataType="vm:SettingsWindowViewModel"
        Title="Ajustes">
    <StackPanel HorizontalAlignment="Center" Width="250" Margin="20">
        <TextBlock
            Text="Ajustes"
            FontSize="30"
            TextAlignment="Center"
            Margin="0 0 0 10"/>
        <Label
            Content="Precio del dolar:"/>
        <TextBox
            Text="{Binding DolarPrice }"/>
        <Button
            HorizontalAlignment="Center"
            Content="Guardar"
            Classes="Primary"
            Width="90"
            Margin="20"
            Command="{Binding SaveCommand}"/>
    </StackPanel>
</Window>
