<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasyPrice.NET.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720" MinWidth="800" MinHeight="700"
        x:Class="EasyPrice.NET.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="EasyPrice.NET">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <StackPanel 
            DockPanel.Dock="Top" 
            HorizontalAlignment="Left" 
            Spacing="15" Margin="10"
            Orientation="Horizontal">
            <Button
                Content="Agregar productos"
                Command="{Binding ShowAddProductWindowCommand}"/>
            <Button
                Content="Ajustes"
                Command="{Binding ShowSettingsWindowCommand}"/>
        </StackPanel>
        <Grid ColumnDefinitions="1* 15* 1*" RowDefinitions=".25* .5* 4*">
            <TextBlock Grid.Column="1" Grid.Row="0"
                TextAlignment="Center"
                Text="Lista de productos"
                Margin="1"
                FontSize="30"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                PlaceholderText="Que producto buscas?"
                Height="10"
                Margin="10 0"/>
            <DataGrid Grid.Row="2" Grid.Column="1"
                Margin="10 0 10 20"
                ItemsSource="{Binding Products, Mode=TwoWay}"
                IsReadOnly="True"
                Background="Gray">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Header="Producto"
                        Width="2.3*"
                        Binding="{Binding Name}"/>
                    <DataGridTextColumn
                        Width="1*"
                        Header="Precio en Bs."
                        Binding="{Binding PackPrice}"/>
                    <DataGridTextColumn
                        Width="1*"
                        Header="Precio en $"
                        Binding="{Binding PackPrice}"/>
                    <DataGridTemplateColumn Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        Content="Cambiar precio"
                                        Classes="Primary"/>
                                    <Button
                                        Content="Eliminar"
                                        Classes="Destructive"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>

</Window>
