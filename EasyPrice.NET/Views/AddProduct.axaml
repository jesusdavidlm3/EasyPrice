<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EasyPrice.NET.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" Width="800" Height="450" CanResize="False"
        x:Class="EasyPrice.NET.Views.AddProduct"
        Title="Agregar producto"
        x:DataType="vm:AddProductViewModel">
    
    <StackPanel Width="500">
        <TextBlock
            Text="Agregar producto" 
            TextAlignment="Center" 
            Margin="0 10 0 20"
            FontSize="30"/>
        <Label Content="Nombre del producto"/>
        <TextBox 
            Text="{Binding Name}"/>
        <Label Content="Cuanto costo el bulto?" Margin="0 15 0 0"/>
        <TextBox 
            Text="{Binding PackPrice}"/>
        <Label Content="Cuantas unidades trae el bulto?" Margin="0 15 0 0"/>
        <TextBox 
            Text="{Binding PackQuantity}"/>
        <Label Content="Que ganancia desea obtener?" Margin="0 15 0 0"/>
        <TextBox 
            Text="{Binding Gain}"/>
        <Button
            Content="Guardar"
            Classes="Primary"
            Width="90"
            Margin="20"
            Command="{Binding Finish}"/>
    </StackPanel>
</Window>
