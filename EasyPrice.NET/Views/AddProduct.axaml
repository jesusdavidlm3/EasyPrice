<shadUI:Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shadUI="clr-namespace:ShadUI;assembly=ShadUI"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" Width="800" Height="450" CanResize="False"
        x:Class="EasyPrice.NET.Views.AddProduct"
        Title="Agregar producto">
    <StackPanel Width="500">
        <TextBlock
            Text="Agregar producto" 
            TextAlignment="Center" 
            Margin="0 10 0 20"
            FontSize="30"/>
        <Label Content="Nombre del producto"/>
        <TextBox 
            />
        <Label Content="Cuanto costo el bulto?" Margin="0 15 0 0"/>
        <TextBox 
        />
        <Label Content="Cuantas unidades trae el bulto?" Margin="0 15 0 0"/>
        <TextBox 
        />
        <Label Content="Que ganancia desea obtener?" Margin="0 15 0 0"/>
        <TextBox 
        />
        <Button
            Content="Guardar"
            Classes="Primary"
            Width="90"
            Margin="20"/>
    </StackPanel>
</shadUI:Window>
