<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" Width="800" Height="450" CanResize="False" WindowStartupLocation="CenterOwner"
        x:Class="EasyPrice.NET.Views.ChangeDolarPrice"
        xmlns:vm="clr-namespace:EasyPrice.NET.ViewModels"
        x:DataType="vm:ChangeDolarPrice"
        Title="Cambiar precio del dolar"
        ShowInTaskbar="False">
    <Grid RowDefinitions="4* 1*" 
        HorizontalAlignment="Center" >
        <StackPanel
            Grid.Row="0"
            Margin="20">
            <TextBlock
                Text="Cambiar precio del dolar"
                FontSize="35"/>
            <Label
                Content="Precio:"/>
            <NumericUpDown
                AllowSpin="False"
                ShowButtonSpinner="False"
                Increment="0.01"
                Value="{Binding DolarPrice }"/>    
        </StackPanel>
        
        <StackPanel
            Grid.Row="1"
            Margin="20"
            Orientation="Horizontal" 
            HorizontalAlignment="Center"
            Spacing="40"
            VerticalAlignment="Bottom">
            <Button
                Classes="Red"
                Content="Cancelar"
                Command="{Binding CancelCommand}"/>
            <Button
                HorizontalAlignment="Center"
                Content="Guardar"
                Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
