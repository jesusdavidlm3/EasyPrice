<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="250" CanResize="False" Width="500" Height="250"
        x:Class="EasyPrice.NET.Views.Modals.ChangePassword"
        xmlns:vm="clr-namespace:EasyPrice.NET.ViewModels"
        x:DataType="vm:ChangePasswordViewModel"
        Title="Cambiar contraseña"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    
    <Window.KeyBindings>
        <KeyBinding
            Gesture="Escape"
            Command="{Binding CancelCommand}"></KeyBinding>    
    </Window.KeyBindings>
    
    <StackPanel HorizontalAlignment="Center" Margin="0 55 0 0" Spacing="15">
        <TextBlock
            FontSize="30"
            Text="Escriba su nueva contraseña"/>
        <TextBox
            Text="{Binding NewPassword}"
            PasswordChar="*">
            <TextBox.KeyBindings>
                <KeyBinding
                    Gesture="Enter"
                    Command="{Binding $parent[Window].((vm:ChangePasswordViewModel)DataContext).SaveCommand}"/>
            </TextBox.KeyBindings>
        </TextBox>
        <Button
            Content="Guardar"
            HorizontalAlignment="Center"
            Command="{Binding SaveCommand}"/>
    </StackPanel>
</Window>
