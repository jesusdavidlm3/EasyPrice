<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EasyPrice.NET.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" Width="800" Height="450" CanResize="False" WindowStartupLocation="CenterOwner"
        x:Class="EasyPrice.NET.Views.DeleteProduct"
        x:DataType="vm:DeleteProductViewModel"
        Title="Eliminar producto">
    
    <Grid RowDefinitions="3* 1*" HorizontalAlignment="Center">
        <TextBlock Grid.Row="0"
            Text="Desea eliminar este producto?"
            FontSize="25"
            TextAlignment="Center"
            VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
            <Button
                Content="Eliminar"
                Command="{Binding DeleteCommand}"
                CommandParameter="{Binding ProductToDelete}"/>
            <Button
                Content="Cancelar"
                Command="{Binding CancelCommand }"/>
        </StackPanel>
    </Grid>
</Window>
