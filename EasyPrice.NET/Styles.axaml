<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20" Width="300">
            <!-- Add Controls for Previewer Here -->
            <StackPanel HorizontalAlignment="Center">
                <Button
                    Content="Hola"/>
                <Button
                    Classes="Red"
                    Content="Hola"/>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <Style Selector="Button">
        <Setter Property="Background" Value="#90caf9"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Padding" Value="10"/>
    </Style>
    
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#42a5f5"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>
    
    <Style Selector="Button.Red">
        <Setter Property="Background" Value="#f44336"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    
    <Style Selector="Button.Red:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#d32f2f"/>
    </Style>
    
    <Style Selector="Window">
        <Setter Property="Background" Value="#003049"/>
    </Style>
    
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="#143f56"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
        
    <Style Selector="DataGridRow">
        <Setter Property="Background" Value="#264d61"/>
        <Setter Property="Padding" Value="0 15"/>
    </Style>
    
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    
    <Style Selector="Label">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    
    <Style Selector="StackPanel.Card">
        <Setter Property="Background" Value="#264d61"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
</Styles>
