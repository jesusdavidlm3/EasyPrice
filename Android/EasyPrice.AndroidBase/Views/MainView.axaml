<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EasyPrice.AndroidBase.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EasyPrice.AndroidBase.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>

    <Grid Classes="PrincipalBackground" RowDefinitions="1* 1* 9*">
      <TextBlock Grid.Row="0" 
        Text="Lista de precios" 
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Margin="0 15 "
        FontSize="30"/>
      <TextBox Grid.Row="1"
        PlaceholderText="Que producto buscas?"
        Height="10"
        Margin="10 0"/>
      <DataGrid Grid.Row="2" Margin="10 0 10 20">
        <DataGrid.Columns>
          <DataGridTextColumn
            Header="Producto"
            Width="2*"/>
          <DataGridTextColumn
            Header="Bs."
            Width="1*"/>
          <DataGridTextColumn
            Header="$"
            Width="1*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
</UserControl>
